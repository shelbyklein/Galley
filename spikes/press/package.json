{
  "name": "galley-press-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Phase 0 press spike: Electron printToPDF + sentinel-color prepress post-processor",
  "scripts": {
    "gen:assets": "tsx src/gen-assets.ts",
    "export": "electron electron/main.cjs --mode=screen && electron electron/main.cjs --mode=export",
    "prepress": "tsx src/prepress/cli.ts",
    "verify": "tsx src/verify.ts",
    "spike": "npm run gen:assets && npm run export && npm run prepress && npm run verify",
    "test": "node --import tsx --test src/prepress/tokenizer.test.ts",
    "experiments": "tsx src/experiments.ts"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "electron": "^44.5.1",
    "pako": "^3.0.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pako": "^2.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wawoff2": "^2.0.1"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.28.2": true
  }
}
