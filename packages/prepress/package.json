{
  "name": "@galley/prepress",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Galley prepress: sentinel colors to CMYK/spot, page boxes, crop marks, PDF/X-4, output profiles and soft proofing, golden separation measurement. Node only (main process and scripts).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./geometry": "./src/geometry.ts",
    "./profiles": "./src/profiles.ts",
    "./softproof": "./src/softproof.ts",
    "./verify": "./src/verify/index.ts",
    "./fonts": "./src/fonts/report.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@galley/model": "*",
    "lcms-wasm": "^1.0.5",
    "pako": "^3.0.2",
    "sharp": "^0.35.5",
    "@galley/fonts": "*"
  },
  "devDependencies": {
    "@types/pako": "^2.0.4"
  }
}
